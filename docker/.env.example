# ==========================================================
# RutaIA - Variables de Entorno Locales (Plantilla)
# ==========================================================

# Base de Datos PostgreSQL
POSTGRES_DB=rutaia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rutaia_db?sslmode=disable

# Base de Datos Vectorial Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=cursos_academicos

# Automatización n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/webhook/recomendar-cursos
N8N_INDEX_WEBHOOK_URL=http://localhost:5678/webhook/indexar-cursos

# OpenRouter (Embeddings & LLM RAG)
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=google/gemini-3.5-flash

# Parámetros de Negocio RAG
SIMILARITY_THRESHOLD=0.65
TOP_K_RESULTS=4

# Backend Spring Boot
SERVER_PORT=8080
