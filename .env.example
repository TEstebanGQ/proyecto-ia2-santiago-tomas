# ==========================================================
# RutaIA - Variables de Entorno de Ejemplo
# Copia este archivo a .env y asigna tus credenciales reales
# ==========================================================

# Base de Datos PostgreSQL
POSTGRES_DB=rutaia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rutaia_db

# Base de Datos Vectorial Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=cursos_academicos

# Automatización n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/webhook/recomendar-cursos
N8N_INDEX_WEBHOOK_URL=http://localhost:5678/webhook/indexar-cursos
N8N_ENCRYPTION_KEY=clave_segura_de_cifrado_n8n_32caracteres

# OpenRouter (Embeddings & LLM RAG)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001

# Parámetros de Negocio RAG
SIMILARITY_THRESHOLD=0.65
TOP_K_RESULTS=4

# Backend Spring Boot
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080,null

# Google Identity Services. El Client ID es publico; el Client Secret no se usa en este flujo.
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
